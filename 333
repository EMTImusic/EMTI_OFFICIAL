<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="description" content="EMTI — Music Artist. Official music, releases and social links.">
<meta name="author" content="EMTI">
<meta name="theme-color" content="#050505">

<title>EMTI — Music Artist</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  min-height:100vh;
  color:#f5f5f5;
  font-family:Inter,Arial,sans-serif;
  background:
    radial-gradient(circle at 50% 0%,rgba(120,0,0,.28),transparent 35%),
    radial-gradient(circle at 0% 100%,rgba(255,0,0,.08),transparent 30%),
    #050505;
  overflow-x:hidden;
}

body::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  opacity:.06;
  background-image:radial-gradient(#fff 1px,transparent 1px);
  background-size:5px 5px;
}

.wrap{
  width:min(920px,92%);
  margin:auto;
}

header{
  text-align:center;
  padding:70px 0 35px;
  animation:show .9s ease both;
}

.avatar{
  width:140px;
  height:140px;
  border-radius:50%;
  object-fit:cover;
  border:1px solid #333;
  box-shadow:
    0 0 0 8px rgba(255,255,255,.025),
    0 0 60px rgba(255,0,0,.20);
  transition:.45s ease;
}

.avatar:hover{
  transform:scale(1.07) rotate(-2deg);
  box-shadow:
    0 0 0 8px rgba(255,255,255,.04),
    0 0 80px rgba(255,0,0,.35);
}

h1{
  margin:28px 0 6px;
  font-family:"Archivo Black",Impact,sans-serif;
  font-size:clamp(65px,15vw,135px);
  line-height:.85;
  letter-spacing:-5px;

  background:linear-gradient(180deg,#fff,#777);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;

  text-shadow:0 0 35px rgba(255,255,255,.08);
}

.artist{
  color:#999;
  font-size:12px;
  letter-spacing:5px;
}

.tag{
  display:inline-block;
  margin-top:20px;
  padding-bottom:8px;
  color:#fff;
  font-size:12px;
  font-weight:700;
  letter-spacing:4px;
  border-bottom:1px solid #b00000;
}

main{
  padding:15px 0 80px;
}

.release{
  position:relative;
  overflow:hidden;
  padding:32px;
  border:1px solid #292929;
  border-radius:24px;
  background:linear-gradient(145deg,#121212,#080808);
  box-shadow:0 20px 70px rgba(0,0,0,.45);
  animation:show 1s .15s ease both;
}

.release::after{
  content:"";
  position:absolute;
  width:200px;
  height:200px;
  right:-90px;
  top:-90px;
  border-radius:50%;
  background:#a00000;
  filter:blur(75px);
  opacity:.2;
}

.eyebrow{
  color:#777;
  font-size:11px;
  letter-spacing:3px;
  text-transform:uppercase;
}

.title{
  margin:10px 0;
  font-family:"Archivo Black",Impact,sans-serif;
  font-size:clamp(34px,8vw,65px);
  letter-spacing:-2px;
}

.sub{
  margin-bottom:25px;
  color:#999;
}

.button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:50px;
  padding:0 22px;
  border:1px solid #333;
  border-radius:14px;
  color:#fff;
  background:#151515;
  text-decoration:none;
  font-size:13px;
  font-weight:700;
  transition:.25s ease;
}

.button:hover{
  transform:translateY(-4px);
  border-color:#900;
  box-shadow:0 15px 40px rgba(150,0,0,.2);
}

.socials{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:10px;
  margin-top:18px;
  animation:show 1s .3s ease both;
}

.social{
  padding:18px 8px;
  border:1px solid #222;
  border-radius:15px;
  color:#ccc;
  background:#0c0c0c;
  text-align:center;
  text-decoration:none;
  font-size:12px;
  font-weight:600;
  transition:.25s ease;
}

.social:hover{
  transform:translateY(-5px);
  border-color:#444;
  color:#fff;
  background:#151515;
}

.about{
  padding:70px 0 15px;
  color:#777;
  text-align:center;
  font-size:12px;
  letter-spacing:2px;
}

footer{
  padding-bottom:35px;
  color:#444;
  text-align:center;
  font-size:10px;
}

@keyframes show{
  from{
    opacity:0;
    transform:translateY(25px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

@media(max-width:650px){
  .socials{
    grid-template-columns:repeat(2,1fr);
  }

  .social:last-child{
    grid-column:1/-1;
  }

  .release{
    padding:25px;
  }
}
</style>

